{
	"compilerOptions": {
		"target": "ES2022",
		"module": "node16",
		"allowSyntheticDefaultImports": true,
		"moduleResolution": "node16",
		"skipLibCheck": true,
		"lib": ["DOM", "ES2022"],
		"allowJs": true,
		"forceConsistentCasingInFileNames": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"experimentalDecorators": true,
		"sourceMap": true,
		"rootDir": "",
		"outDir": "./dist",
		"noImplicitAny": true
	},
	"include": ["src/**/*", "libs/**/*"],
	"exclude": ["node_modules"],
	"ts-node": {
		"files": true
	}
}
